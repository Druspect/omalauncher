widget "omawatch" {
  page: 1
  order: 61
  size: 3x3
  minSize: 3x2
  meta { description: "Pair and control the OmaWatch bridge: trust, theme, and agent status"; version: "1.0"; license: "MIT"; category: "system"; owl: 7 }

  source bridge = android.watch

  onTap: screen()

  Column {
    gap: 4
    Row {
      align: center
      Text { text: "omawatch"; style: title; color: accent; weight: 1 }
      Text { text: bridge.pinned ? "paired" : bridge.pending != null ? "confirm" : "offline"; style: label; color: bridge.pinned ? green : bridge.pending != null ? yellow : muted }
    }
    Text { text: bridge.line; style: small; color: foreground; maxLines: 1 }
    Text { text: bridge.theme == null ? "theme: waiting" : "theme: ${bridge.theme}"; style: small; color: muted; maxLines: 1 }
    Row {
      gap: 4
      Button { text: bridge.pending != null ? "pin" : "hello"; color: accent; onTap: watch(bridge.pending != null ? "pin" : "hello") }
      if bridge.pinned { Button { text: "unpair"; color: muted; onTap: watch("unpair") } }
    }
  }

  screen {
    title: "omawatch bridge"
    Column {
      scroll: true
      gap: 8
      Text { text: "omawatch bridge"; style: huge; color: accent }
      Text { text: bridge.line; style: title; color: foreground }
      Text { text: bridge.pinned ? "trusted watch" : bridge.pending != null ? "new watch found — confirm below" : "no trusted watch"; color: muted }
      Text { text: bridge.fingerprint ?? bridge.pending ?? "fingerprint unavailable"; font: mono; fontSize: 11; color: foreground; maxLines: 3 }
      Text { text: bridge.theme == null ? "theme: not sent" : "theme: ${bridge.theme}"; color: foreground }
      Row {
        gap: 8
        Button { text: bridge.pending != null ? "confirm watch" : "send hello"; color: accent; onTap: watch(bridge.pending != null ? "pin" : "hello") }
        if bridge.pinned { Button { text: "unpair"; color: red; onTap: watch("unpair") } }
      }
      Text { text: "The watch receives the launcher's four resolved theme colors. Hold-to-talk prompts are verified with the pinned watch key and run through the selected phone agent."; style: small; color: muted }
    }
  }
}
